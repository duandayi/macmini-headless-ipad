#!/bin/bash
# sidecar-report —— 测试期报告：每次开机多久连上、有没有人工干预、有没有被改动
LOG="$HOME/Library/Logs/sidecar-guard.log"
PLOG="/Library/Logs/dsh-sidecar-protect.log"
START_FILE="$HOME/.config/sidecar/test-start"
START=$(cat "$START_FILE" 2>/dev/null || echo "2026-10-27 00:00:00")

echo "=== 测试期报告（自 $START 起）==="
echo
# 用 python 更准确地算时长
/Users/duandayi/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/python/bin/python3 - "$LOG" "$START" <<'PYEOF'
import sys, re, datetime
log, start = sys.argv[1], sys.argv[2]
rows = []
try:
    lines = open(log, encoding="utf-8").read().splitlines()
except FileNotFoundError:
    lines = []
def ts(line):
    m = re.match(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)", line)
    return datetime.datetime.strptime(m.group(1), "%Y-%m-%d %H:%M:%S") if m else None
cur = None
for ln in lines:
    if ln < start: continue
    m = re.search(r"开机后 (\d+)s", ln)
    if re.search(r"sidecar-guard (v\d+ )?启动", ln) and (m is None or int(m.group(1)) <= 600):
        cur = {"boot": ts(ln), "conn": None, "wake": 0, "heal": 0}
    elif cur:
        if "已恢复连接" in ln and not cur["conn"]:
            cur["conn"] = ts(ln)
        if "sidecarctl connect" in ln: cur["wake"] += 1
        if "[USB]" in ln: cur["usb"] = (cur.get("usb") or 0) + 1
        if not re.search(r"sidecar-guard (v\d+ )?启动", ln) and cur["conn"]:
            rows.append(cur); cur = None
if cur and cur["conn"]: rows.append(cur)
print(f"{'开机':<20}{'连上耗时':<10}{'重连次数'}")
for r in rows:
    b = r["boot"]; c = r["conn"]
    took = f'{(c-b).seconds}s' if c else '未连上'
    print(f"{b:%Y-%m-%d %H:%M:%S}  {took:<10}{r['wake']}")
if not rows:
    print("（暂无记录，跑一次开机后就会有）")
PYEOF
echo
echo "=== 是否被改动过（root 看护日志）==="
if [ -f "$PLOG" ]; then
    n=$(awk -v s="$START" '$0 >= s' "$PLOG" 2>/dev/null | grep -c "已恢复\|已重新加载\|已补齐\|kickstart")
    echo "  改动/自动修复记录: $n 条"
    [ "$n" -gt 0 ] && awk -v s="$START" '$0 >= s' "$PLOG" | grep "已恢复\|已重新加载\|已补齐\|kickstart" | tail -5
else
    echo "  无日志"
fi
echo
echo "=== 当前状态 ==="
grep -o "connected=[a-z]*" /tmp/sidecar-guard.status 2>/dev/null | sed 's/^/  /'
grep -o "connects=[0-9]*\|usb_ipad=[a-z]*\|last_trigger=.*" /tmp/sidecar-guard.status 2>/dev/null | sed 's/^/  /'

# ---------- 救援统计（数据驱动优化的依据）----------
RLOG="$HOME/Library/Logs/sidecar-rescue.log"
if [ -s "$RLOG" ]; then
    echo
    echo "=== 救援统计（自动恢复能力）==="
    /Users/duandayi/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/python/bin/python3 - "$RLOG" <<'RLOGEOF'
import sys, collections
rows = [l.split("|") for l in open(sys.argv[1], encoding="utf-8").read().splitlines() if l.count("|") == 4]
used = collections.Counter(); ok = collections.Counter(); durs = []
for t, kind, level, result, secs in rows:
    if kind == "救援":
        used[level] += 1
        if result == "成功": ok[level] += 1
    elif kind == "恢复" and secs.isdigit():
        durs.append(int(secs))
print("  各级救援使用次数 / 成功次数：")
for lv in ["L2","L3","L4","L5"]:
    if used[lv]: print(f"    {lv}: {used[lv]} 次 / 成功 {ok[lv]} 次")
if not used: print("    （还没有触发过救援）")
if durs:
    print(f"  平均恢复耗时：{sum(durs)//len(durs)} 秒（共 {len(durs)} 次）")
    print(f"  最长恢复耗时：{max(durs)} 秒")
RLOGEOF
fi
