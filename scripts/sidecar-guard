#!/bin/bash
# sidecar-guard v18 — 私有 API 直连 + USB 优先 + 近场感应 + 不打扰用户
LOG="$HOME/Library/Logs/sidecar-guard.log"
STATUS="/tmp/sidecar-guard.status"
PAUSE="$HOME/.sidecar-pause"
BIN="$HOME/.local/bin"
VDNAME="${VDISPLAY_NAME:-SideLinker-HD}"
CFG="$HOME/.config/sidecar/config.sh"
[ -f "$CFG" ] && . "$CFG"
TARGET="${SIDECAR_DEVICE_ID:-}"
TICK=5
FALLBACK_TICKS=6
GU=$(id -u)
COOLDOWN_FILE=/tmp/sidecar-cooldown
BOOT_PHASE=300
PAUSE_MAX=600          # 暂停上限 10 分钟
logit() { echo "$(date '+%F %T') $*" >> "$LOG"; }

idle_seconds() {
    local ns
    ns=$(ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print $NF; exit}')
    [ -n "$ns" ] && echo $((ns / 1000000000)) || echo 0
}

# 已连接设备数量（>=1 即视为已连接，兼容多台设备）
connected_count() {
    local n
    n=$("$BIN/sidecarctl" list 2>/dev/null | awk '/^已连接/ {gsub(/[^0-9]/,""); print; exit}')
    echo "${n:-0}"
}
connected() { [ "$(connected_count)" -ge 1 ] 2>/dev/null; }

ipad_on_usb() {
    system_profiler SPUSBDataType 2>/dev/null \
      | grep -E "^[[:space:]]+[^[:space:]].*iPad" >/dev/null 2>&1
}

ipad_rssi() {
    system_profiler SPBluetoothDataType 2>/dev/null | awk '
        /iPad/ {f=1}
        f && /RSSI:/ {gsub(/.*RSSI: */,""); gsub(/[^0-9-].*/,""); print; exit}'
}

BT=$(sysctl -n kern.boottime | sed -E 's/^\{ sec = ([0-9]+).*/\1/')
UPTIME=$(( $(date +%s) - BT ))
logit "=== sidecar-guard v18 启动 (pid $$, 开机后 ${UPTIME}s) ==="
FAILS=0; CONNECTS=0; TICKN=0; LAST_HB=$(date +%s); LAST_TRIGGER=""
BACKOFF=5; NEAR=0; COOLDOWN_UNTIL=0

while true; do
    now=$(date +%s); TICKN=$((TICKN+1))

    # --- 暂停（最多 10 分钟自动恢复）---
    if [ -f "$PAUSE" ]; then
        age=$(( now - $(stat -f %m "$PAUSE" 2>/dev/null || echo "$now") ))
        if [ "$age" -gt "$PAUSE_MAX" ]; then
            rm -f "$PAUSE"
            logit "暂停已超过 10 分钟（${age}s），自动恢复自动重连"
        else
            printf "updated=%s\nstate=paused\nauto_resume_in=%ss\nconnected=%s\n" \
                "$(date '+%F %T')" $((PAUSE_MAX - age)) \
                "$(connected && echo yes || echo no)" > "$STATUS"
            sleep 15; continue
        fi
    fi

    # --- 虚拟屏：只由 LaunchAgent 负责（单一所有者，避免双开）---
    if ! pgrep -f "$BIN/vdisplay" >/dev/null 2>&1; then
        launchctl kickstart -k "gui/$GU/com.dsh.vdisplay" >/dev/null 2>&1
        logit "虚拟屏进程不在，已 kickstart vdisplay（不自行 spawn，避免双开）"
        sleep 3
    fi

    usb=no; ipad_on_usb && usb=yes
    rssi=$(ipad_rssi)
    UP=$(( $(date +%s) - BT ))
    [ -f "$COOLDOWN_FILE" ] && COOLDOWN_UNTIL=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)

    if connected; then
        if [ "$FAILS" -gt 0 ]; then logit "已恢复（本次累计重连 ${CONNECTS} 次）"; fi
        FAILS=0; BACKOFF=5; COOLDOWN_UNTIL=0; state=yes
    else
        state=no
        if [ "$now" -lt "$COOLDOWN_UNTIL" ]; then
            # 冷却中：iPad 回到很近的地方（> -50dBm）连续两次 → 自动取消冷却
            if [ -n "$rssi" ] && [ "$rssi" -gt -50 ] 2>/dev/null; then
                NEAR=$((NEAR+1))
                if [ "$NEAR" -ge 2 ]; then
                    logit "[回到附近] 信号 ${rssi}，取消冷却"
                    rm -f "$COOLDOWN_FILE"; COOLDOWN_UNTIL=0; NEAR=0
                fi
            else
                NEAR=0
            fi
            LAST_TRIGGER="冷却中 $(($COOLDOWN_UNTIL - now))s"
        else
            idle=$(idle_seconds)
            trigger=""
            if [ "$UP" -lt "$BOOT_PHASE" ]; then
                trigger="开机阶段"
            elif [ "$usb" = "yes" ]; then
                trigger="USB"
            elif [ "$idle" -gt 120 ] && { [ -z "$rssi" ] || [ "$rssi" -lt -50 ]; }; then
                # Mac 侧无操作 + iPad 不在旁边 → 用户带走了 iPad，先不打扰
                COOLDOWN_UNTIL=$((now + 600)); echo "$COOLDOWN_UNTIL" > "$COOLDOWN_FILE"; NEAR=0
                logit "[用户在用 iPad] Mac 空闲 ${idle}s 且 iPad 不在近处，暂停自动重连 10 分钟"
                LAST_TRIGGER="用户在用 iPad"
            elif [ -n "$rssi" ] && [ "$rssi" -gt -60 ] 2>/dev/null; then
                trigger="近场(信号 ${rssi})"
            elif [ $((TICKN % FALLBACK_TICKS)) -eq 0 ]; then
                trigger="定时兜底"
            fi

            if [ -n "$trigger" ]; then
                CONNECTS=$((CONNECTS+1)); FAILS=$((FAILS+1))
                logit "[${trigger}] 未连接 → sidecarctl connect"
                out=$("$BIN/sidecarctl" connect "$TARGET" 2>&1 | tr '\n' ' ')
                logit "sidecarctl: $out"
                LAST_TRIGGER="$trigger"
                sleep 2
                if connected; then
                    logit "重连成功"; FAILS=0; BACKOFF=5; state=yes
                else
                    BACKOFF=$(( BACKOFF * 2 )); [ "$BACKOFF" -gt 120 ] && BACKOFF=120
                    sleep "$BACKOFF"
                fi
            fi
        fi
    fi

    {
        echo "updated=$(date '+%F %T')"
        echo "state=running"
        echo "connected=$state"
        echo "connected_count=$(connected_count)"
        echo "connects=$CONNECTS"
        echo "usb_ipad=$usb"
        echo "bt_rssi=${rssi:-?}"
        echo "last_trigger=${LAST_TRIGGER:-—}"
        echo "idle_s=$(idle_seconds)"
        if [ "$(date +%s)" -lt "$COOLDOWN_UNTIL" ]; then
            echo "cooldown_left=$((COOLDOWN_UNTIL - $(date +%s)))"
        else
            echo "cooldown_left=0"
        fi
        echo "vdisplay=$(pgrep -f "$BIN/vdisplay" >/dev/null && echo yes || echo no)"
        echo "backend=SidecarCore(private)"
        echo "tick=${TICK}s"
        echo "target=${TARGET:-未绑定}"
        echo "boot_at=$(date -r "$(sysctl -n kern.boottime | sed -E 's/^\{ sec = ([0-9]+).*/\1/')" '+%F %T')"
    } > "$STATUS"

    if [ $((now - LAST_HB)) -ge 600 ]; then
        LAST_HB=$now; logit "[心跳] 连接=${state} | 重连 ${CONNECTS} 次 | 触发=${LAST_TRIGGER:-—}"
    fi
    sleep "$TICK"
done
