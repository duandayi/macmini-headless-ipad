<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL_PREFIX__.vdisplay</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/vdisplay</string>
    <string>--name</string><string>__VDISPLAY_NAME__</string>
    <string>--w</string><string>__LOGICAL_W__</string>
    <string>--h</string><string>__LOGICAL_H__</string>
    <string>--scale</string><string>2</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>StandardOutPath</key><string>/tmp/vdisplay.out</string>
  <key>StandardErrorPath</key><string>/tmp/vdisplay.err</string>
</dict>
</plist>
